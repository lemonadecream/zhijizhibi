# 职己职彼 · 后端环境变量示例
#
# 用法：复制本文件为同目录下的 `.env`，按需修改。
#   macOS / Linux : cp .env.example .env
#   Windows       : copy .env.example .env
#
# `.env` 含密钥，已被 .gitignore 排除，切勿提交到 Git。

# ---------- 运行模式 ----------
# true  = 本地开发：允许使用占位 JWT_SECRET，启动更宽容，方便第一次跑起来。
# false = 生产：必须提供强随机 JWT_SECRET，否则启动时直接拒绝运行（安全阀）。
DEBUG=true

# ---------- 数据库 ----------
# 本地 / 测试：SQLite，零外部依赖，首次启动自动建表（37 张表）。
DATABASE_URL=sqlite:///./dev.db
# 生产（配合根目录 docker-compose.yml）：
# DATABASE_URL=postgresql://career:career_pass@localhost:5432/career

# ---------- 认证 ----------
# 生产环境请生成强随机串：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- AI（任意 OpenAI 兼容端点）----------
# 网关通过 HTTP 调用 {AI_BASE_URL}/chat/completions，不绑定任何厂商 SDK。
# 官方 OpenAI、Azure OpenAI、DeepSeek、通义、Moonshot、本地 Ollama / vLLM
# 等一切 OpenAI 兼容端点均可，只需改下面三行。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
#
# 没有 API Key？把下一行改为 mock：
#   mock   = 确定性演示数据，不联网、不需要 Key，可完整体验全部功能（界面会如实
#            标注"演示模式"；AI 结果由程序兜底生成，链路与真实 AI 完全一致）
#   openai = 真实调用上面配置的端点
AI_PROVIDER=openai

AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# ---------- 文件存储 ----------
# 上传的简历（PDF / DOCX）存放目录，可替换为私有对象存储。
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=10

# ---------- CORS ----------
# 允许访问后端的前端来源，多个用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173
