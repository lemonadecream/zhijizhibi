# 职己职彼 · 环境变量示例（Docker Compose 部署用）
#
# Docker Compose 会自动读取根目录的 `.env` 文件：
#   cp .env.example .env    (macOS / Linux)
#   copy .env.example .env  (Windows)
#
# 若你只想在本地直接跑后端（不使用 Docker），请改用 backend/.env.example。
# `.env` 含密钥，已被 .gitignore 排除，切勿提交到 Git。

# ---------- 运行模式 ----------
DEBUG=false

# ---------- 认证 ----------
# 必填。compose 在缺失时直接报错，杜绝占位符上线。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- 数据库 ----------
# compose 使用 PostgreSQL 容器；POSTGRES_PASSWORD 用于初始化数据库口令。
POSTGRES_PASSWORD=career_pass
# 本地直跑后端时改用 SQLite：
# DATABASE_URL=sqlite:///./dev.db

# ---------- AI（任意 OpenAI 兼容端点）----------
# 网关通过 HTTP 调用 {AI_BASE_URL}/chat/completions，不绑定任何厂商 SDK。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# openai = 真实调用；mock = 确定性演示数据，无需 Key、不联网、可完整体验全部功能
AI_PROVIDER=openai
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# ---------- 文件存储 ----------
STORAGE_ROOT=/app/storage
MAX_UPLOAD_MB=10

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173
