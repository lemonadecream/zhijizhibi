# Frontend environment variables (example).
# Copy to `.env.local` — Vite loads it automatically.
#
# SECURITY: only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put an AI provider key here — API keys live in the BACKEND `.env` only.
# The frontend never talks to a model provider directly; all AI calls go through
# the backend AI Gateway.

# Backend origin. Leave EMPTY for local development:
#   vite.config.ts proxies `/api` -> http://localhost:8000
VITE_API_BASE=

# For a deployed backend, set the origin (no trailing slash, no `/api` suffix):
# VITE_API_BASE=https://your-backend.example.com
